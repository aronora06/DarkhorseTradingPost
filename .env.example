# Copy to `.env` at repo root (or `/etc/darkhorse/.env` in production). Never commit `.env`.
# See `plans/decisions/0012-configuration-and-secrets.md`.

# Anthropic
ANTHROPIC_API_KEY=sk-ant-api03-...

# Alpaca — live
ALPACA_LIVE_API_KEY=PK...
ALPACA_LIVE_SECRET_KEY=...

# Alpaca — paper (shadow)
ALPACA_PAPER_API_KEY=PK...
ALPACA_PAPER_SECRET_KEY=...

# Research / news
PERPLEXITY_API_KEY=pplx-...
TAVILY_API_KEY=tvly-...
FINNHUB_API_KEY=...

# SnapTrade (Fidelity read-only; optional until linked)
SNAPTRADE_CLIENT_ID=...
SNAPTRADE_CONSUMER_KEY=...

# Notifications (rotate if exposed)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Human kill flag (see `tests/specs/kill_switch.md`). ``1`` blocks trading.
# DARKHORSE_KILL=0
